#!/usr/bin/env bash
# tum-system-report — meldet System- und Patchstand eines Servers an das
# IT-Inventar des TUM IT-Portals (tum.system-report/v2).
#
# Für Server ohne Laravel-Anwendung. Braucht nur bash und curl, kein Root
# (apt-get/dnf laufen als Simulation). Liest das Token aus einer Datei,
# damit es weder in der Crontab noch in der Prozessliste steht.
#
#   tum-system-report [--dry-run] [--config DATEI] [--random-delay SEKUNDEN]
#                     [--composer VERZEICHNIS]... [--php PHP-BINARY]
#                     [--python PYTHON-BINARY] [--container]
#                     [--hostname NAME] [--environment ENV]
#                     [--app-name NAME] [--app-version VERSION]
#   tum-system-report --send-payload DATEI [--config DATEI]
#
# --composer meldet die installierten Composer-Pakete einer PHP-Anwendung
# ohne Laravel (WordPress, Symfony, …) für den Schwachstellen-Abgleich;
# mehrfach angebbar. Braucht dafür die PHP-CLI (Default: php).
# --python meldet Version und installierte Pakete dieses Python (z. B. eines
# venv) für Support-Ende und Schwachstellen-Abgleich.
# --container: Meldung aus einem Container-Image (z. B. in der CI). Kernel,
# Uptime und Neustart gehören dann dem Host, Updates kommen mit dem nächsten
# Image — gemeldet wird nur os-release, ohne Patchstand.
# --send-payload schickt einen vorher mit --dry-run erzeugten Payload, etwa
# wenn das Image selbst kein curl hat.
#
# Konfiguration (Default /etc/tum-system-report.conf, Rechte 600):
#   TOKEN=itps_…
#   URL=https://portal.it.tum.de/interface/systems/report   (optional)
#
# Exit-Codes: 0 gemeldet, 1 Meldung abgelehnt/fehlgeschlagen, 2 Aufruffehler.

set -euo pipefail

VERSION="2.3.0"
SCHEMA="tum.system-report/v2"
DEFAULT_URL="https://portal.it.tum.de/interface/systems/report"

# Nur für Tests: Präfix für Systempfade und Ersatz für Paketmanager.
ROOT="${TUM_SYSTEM_REPORT_ROOT:-}"
APT_GET="${TUM_SYSTEM_REPORT_APT_GET:-apt-get}"
DNF="${TUM_SYSTEM_REPORT_DNF:-dnf}"

config_file="/etc/tum-system-report.conf"
dry_run=0
random_delay=0

composer_dirs=()
php_bin="${TUM_SYSTEM_REPORT_PHP:-php}"
python_bin=""
container=0
hostname_override=""
environment=""
app_name=""
app_version=""
send_payload=""

usage() {
    sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) dry_run=1 ;;
        --config) config_file="${2:?--config braucht eine Datei}"; shift ;;
        --random-delay) random_delay="${2:?--random-delay braucht Sekunden}"; shift ;;
        --composer) composer_dirs+=("${2:?--composer braucht ein Verzeichnis}"); shift ;;
        --php) php_bin="${2:?--php braucht ein PHP-Binary}"; shift ;;
        --python) python_bin="${2:?--python braucht ein Python-Binary}"; shift ;;
        --container) container=1 ;;
        --hostname) hostname_override="${2:?--hostname braucht einen Namen}"; shift ;;
        --environment) environment="${2:?--environment braucht einen Wert}"; shift ;;
        --app-name) app_name="${2:?--app-name braucht einen Namen}"; shift ;;
        --app-version) app_version="${2:?--app-version braucht eine Version}"; shift ;;
        --send-payload) send_payload="${2:?--send-payload braucht eine Datei}"; shift ;;
        -h|--help) usage; exit 0 ;;
        --version) echo "tum-system-report $VERSION"; exit 0 ;;
        *) echo "Unbekannte Option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

errors=()

# Kürzen (${s:0:n}) zählt im C-Locale Bytes und könnte einen Umlaut halbieren
# — ungültiges UTF-8. Cron setzt meist kein LANG: dann ein UTF-8-Locale wählen,
# falls vorhanden. Paketmanager laufen ohnehin mit eigenem LC_ALL=C.
for candidate in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    if locale -a 2>/dev/null | grep -qx "$candidate"; then
        export LC_ALL="$candidate"
        break
    fi
done

# --- JSON-Helfer ---------------------------------------------------------

# JSON-String inklusive Anführungszeichen; Steuerzeichen fallen weg.
json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/ }"
    s="${s//$'\n'/ }"
    s="${s//$'\r'/}"
    s="$(printf '%s' "$s" | tr -d '\000-\037')"
    printf '"%s"' "$s"
}

# Baut ein Objekt aus Paaren "schlüssel" "json-wert"; leere Werte fallen weg.
json_obj() {
    local out="" key value
    while [ $# -ge 2 ]; do
        key="$1"; value="$2"; shift 2
        [ -z "$value" ] && continue
        out="${out:+$out,}$(json_str "$key"):$value"
    done
    printf '{%s}' "$out"
}

json_int() {
    case "$1" in
        ''|*[!0-9]*) ;;
        *) printf '%s' "$1" ;;
    esac
}

# Kürzt auf N Zeichen und gibt einen JSON-String aus (leer bleibt leer).
json_str_max() {
    [ -z "$1" ] && return 0
    json_str "${1:0:$2}"
}

# --- Sammeln -------------------------------------------------------------

os_release_value() {
    local file="$ROOT/etc/os-release" line
    [ -r "$file" ] || return 0
    line="$(grep -E "^$1=" "$file" | head -n1 || true)"
    line="${line#*=}"
    line="${line%\"}"
    line="${line#\"}"
    printf '%s' "$line"
}

hostname_value() {
    if [ -n "$ROOT" ] && [ -r "$ROOT/etc/hostname" ]; then
        head -n1 "$ROOT/etc/hostname"
    else
        hostname -f 2>/dev/null || hostname 2>/dev/null || true
    fi
}

uptime_value() {
    local file="$ROOT/proc/uptime" up
    [ -r "$file" ] || return 0
    read -r up _ < "$file" || return 0
    printf '%s' "${up%%.*}"
}

last_upgrade_value() {
    local file mtime
    for file in /var/log/apt/history.log /var/lib/dpkg/status /var/log/dnf.rpm.log /var/lib/rpm/rpmdb.sqlite; do
        if [ -e "$ROOT$file" ]; then
            mtime="$(stat -c %Y "$ROOT$file" 2>/dev/null || stat -f %m "$ROOT$file" 2>/dev/null || true)"
            if [ -n "$mtime" ]; then
                date -u -d "@$mtime" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null \
                    || date -u -r "$mtime" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true
                return 0
            fi
        fi
    done
}

# Setzen $patch_json (oder lassen es leer); Fehler landen in $errors.
# Bewusst ohne Ausgabe: in einer $(…)-Subshell gingen die Fehler verloren.
patch_json=""

patch_apt() {
    local output pending=0 security=0 line reboot
    # dist-upgrade statt upgrade: Kernel-Sicherheitsupdates kommen auf
    # Ubuntu als neue Pakete und würden bei "upgrade" zurückgehalten.
    if ! output="$(LC_ALL=C "$APT_GET" -s -o Debug::NoLocking=1 dist-upgrade 2>/dev/null)"; then
        errors+=("os.patch: apt-get failed")
        return 0
    fi
    while IFS= read -r line; do
        case "$line" in
            "Inst "*)
                pending=$((pending + 1))
                case "${line,,}" in *security*) security=$((security + 1)) ;; esac
                ;;
        esac
    done <<< "$output"

    # /var/run/reboot-required legt nur update-notifier an; ohne ihn ist
    # "keine Datei" unbekannt, nicht "kein Neustart nötig".
    if [ -e "$ROOT/var/run/reboot-required" ]; then
        reboot=true
    elif [ -d "$ROOT/usr/share/update-notifier" ]; then
        reboot=false
    else
        reboot=null
    fi

    patch_json="$(json_obj source '"apt"' pending "$pending" security_pending "$security" \
        reboot_required "$reboot" last_upgrade_at "$(json_str_max "$(last_upgrade_value)" 30)")"
}

patch_dnf() {
    local output status pending=0 security=0 reboot=null
    # repoquery statt check-update: eine Zeile je Paket, ohne Umbrüche bei
    # langen Namen und ohne "Obsoleting"-Block (dnf 4 und dnf 5).
    set +e
    output="$(LC_ALL=C "$DNF" -q repoquery --upgrades --qf '%{name}.%{arch}\n' 2>/dev/null)"
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
        errors+=("os.patch: dnf repoquery exit $status")
        return 0
    fi
    pending="$(printf '%s\n' "$output" | grep -v '^[[:space:]]*$' | sort -u | wc -l | tr -d ' ')"

    if output="$(LC_ALL=C "$DNF" -q updateinfo list --security --updates 2>/dev/null)"; then
        # Eine Zeile je Advisory und Paket; gezählt werden Pakete. Die Spalte
        # unterscheidet sich (dnf 4: 3., dnf 5: 4.), darum das Feld nehmen,
        # das wie name-version.arch aussieht — Kopfzeile und Datum nicht.
        security="$(printf '%s\n' "$output" \
            | awk '{ for (i = 2; i <= NF; i++) if ($i ~ /-[0-9][^ ]*\.[A-Za-z0-9_]+$/) { print $i; break } }' \
            | sort -u | wc -l | tr -d ' ')"
    else
        errors+=("os.patch: dnf updateinfo failed")
        security=""
    fi

    # needs-restarting -r: Exit 1 = Neustart nötig, 0 = nicht nötig.
    if command -v needs-restarting >/dev/null 2>&1; then
        set +e
        needs-restarting -r >/dev/null 2>&1
        case $? in 0) reboot=false ;; 1) reboot=true ;; esac
        set -e
    fi

    patch_json="$(json_obj source '"dnf"' pending "$pending" security_pending "$(json_int "$security")" \
        reboot_required "$reboot" last_upgrade_at "$(json_str_max "$(last_upgrade_value)" 30)")"
}

patch_value() {
    if [ -x "$ROOT/usr/bin/apt-get" ] || [ -n "${TUM_SYSTEM_REPORT_APT_GET:-}" ]; then
        patch_apt
    elif [ -x "$ROOT/usr/bin/dnf" ] || [ -n "${TUM_SYSTEM_REPORT_DNF:-}" ]; then
        patch_dnf
    else
        errors+=("os.patch: unsupported package manager")
    fi
}

# --- Composer-Pakete ----------------------------------------------------

# Liest je Verzeichnis vendor/composer/installed.json (was installiert ist,
# ohne dev-Pakete) oder ersatzweise composer.lock (ohne packages-dev) und
# gibt eine JSON-Liste [{"name","version"}] aus. Nur Name und Version; nur
# prüfbare Versionen (keine Branch- oder Git-Stände). Fehler je Verzeichnis
# auf stderr, ohne Pfad (der verriete Benutzer- und Projektnamen).
# Bewusst ohne neuere Syntax: auf Shared Hosting ist die CLI oft älter.
# shellcheck disable=SC2016 # PHP-Code: $-Variablen sollen nicht expandieren
COMPOSER_EXTRACT='
$result = array();
$seen = array();
foreach (array_slice($argv, 1) as $i => $dir) {
    $label = "packages.composer[" . ($i + 1) . "]";
    $installed = $dir . "/vendor/composer/installed.json";
    $lock = $dir . "/composer.lock";
    $packages = null;
    $dev = array();
    if (@is_file($installed)) {
        $data = json_decode((string) @file_get_contents($installed), true);
        if (is_array($data)) {
            $packages = isset($data["packages"]) ? $data["packages"] : (array_values($data) === $data ? $data : array());
            foreach ((array) (isset($data["dev-package-names"]) ? $data["dev-package-names"] : array()) as $name) {
                if (is_string($name)) { $dev[strtolower($name)] = true; }
            }
        }
    } elseif (@is_file($lock)) {
        $data = json_decode((string) @file_get_contents($lock), true);
        if (is_array($data)) {
            $packages = isset($data["packages"]) ? $data["packages"] : array();
        }
    } else {
        fwrite(STDERR, $label . ": no composer.lock
");
        continue;
    }
    if (! is_array($packages)) {
        fwrite(STDERR, $label . ": not readable
");
        continue;
    }
    foreach ($packages as $p) {
        if (! is_array($p) || ! isset($p["name"], $p["version"]) || ! is_string($p["name"]) || ! is_string($p["version"])) { continue; }
        $name = $p["name"];
        $version = $p["version"];
        if (isset($dev[strtolower($name)]) || strlen($name) > 214 || strlen($version) > 64) { continue; }
        if (! preg_match("/^v?\\d+(\\.\\d+)*([-+.][0-9A-Za-z.+-]*)?$/", $version) || substr($version, -4) === "-dev") { continue; }
        $key = strtolower($name) . "@" . strtolower($version);
        if (isset($seen[$key])) { continue; }
        $seen[$key] = true;
        $result[] = array("name" => $name, "version" => $version);
    }
}
usort($result, function ($a, $b) { return strcmp($a["name"] . "@" . $a["version"], $b["name"] . "@" . $b["version"]); });
echo json_encode(array_slice($result, 0, 3000), JSON_UNESCAPED_SLASHES);
'

# Setzt $composer_json (oder lässt es leer); Fehler landen in $errors.
composer_json=""

composer_value() {
    local output err_file line
    [ "${#composer_dirs[@]}" -eq 0 ] && return 0
    if ! command -v "$php_bin" >/dev/null 2>&1; then
        errors+=("packages.composer: php not found")
        return 0
    fi
    err_file="$(mktemp)"
    if ! output="$("$php_bin" -d display_errors=stderr -r "$COMPOSER_EXTRACT" "${composer_dirs[@]}" 2>"$err_file")"; then
        errors+=("packages.composer: php failed")
        output=""
    fi
    while IFS= read -r line; do
        case "$line" in
            packages.composer*) errors+=("$line") ;;
        esac
    done < "$err_file"
    rm -f "$err_file"
    case "$output" in
        '['*']') [ "$output" != "[]" ] && composer_json="$output" ;;
    esac
    return 0
}

# --- Python ------------------------------------------------------------

# Läuft mit -I (ohne Benutzer-site-packages, PYTHON*-Variablen und das
# aktuelle Verzeichnis): gemeldet wird, was dieses Python importieren würde.
# Zeile 1: Laufzeit, Zeile 2: Pakete [{"name","version"}]. Je Name nur die
# erste Fundstelle auf sys.path — die, die tatsächlich geladen wird.
# Bewusst ohne neuere Syntax: ab Python 3.8 (importlib.metadata).
PYTHON_EXTRACT='
import json, platform, re
from importlib import metadata
seen = {}
for dist in metadata.distributions():
    try:
        name = dist.metadata["Name"]
        version = dist.version
    except Exception:
        continue
    if not isinstance(name, str) or not isinstance(version, str) or not name or not version:
        continue
    if len(name) > 214 or len(version) > 64:
        continue
    key = re.sub(r"[-_.]+", "-", name).lower()
    if key not in seen:
        seen[key] = {"name": name, "version": version}
packages = sorted(seen.values(), key=lambda p: (p["name"].lower(), p["version"]))[:3000]
print(json.dumps({"version": platform.python_version(), "implementation": platform.python_implementation()}, separators=(",", ":")))
print(json.dumps(packages, separators=(",", ":")))
'

# Setzen $python_runtime_json und $pypi_json; Fehler landen in $errors.
python_runtime_json=""
pypi_json=""

python_value() {
    local output runtime packages
    [ -z "$python_bin" ] && return 0
    if ! command -v "$python_bin" >/dev/null 2>&1; then
        errors+=("packages.pypi: python not found")
        return 0
    fi
    if ! output="$("$python_bin" -I -c "$PYTHON_EXTRACT" 2>/dev/null)"; then
        errors+=("packages.pypi: python failed")
        return 0
    fi
    runtime="$(printf '%s\n' "$output" | sed -n 1p)"
    packages="$(printf '%s\n' "$output" | sed -n 2p)"
    case "$runtime" in '{'*'}') python_runtime_json="$runtime" ;; esac
    case "$packages" in
        '['*']') [ "$packages" != "[]" ] && pypi_json="$packages" ;;
        *) errors+=("packages.pypi: unreadable output") ;;
    esac
    return 0
}

build_payload() {
    local reported_at os_obj instance_obj reporter_obj app_obj runtime_obj errors_json="" e capabilities
    local kernel="" uptime="" packages_json

    reported_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    capabilities='"os"'
    if [ "$container" -eq 0 ]; then
        patch_value
        capabilities="$capabilities,\"os_patch\""
        kernel="$(json_str_max "$(uname -r 2>/dev/null || true)" 100)"
        uptime="$(json_int "$(uptime_value)")"
    fi
    composer_value
    python_value
    [ -n "$python_runtime_json" ] && capabilities="$capabilities,\"runtime\""
    if [ "${#composer_dirs[@]}" -gt 0 ] || [ -n "$python_bin" ]; then
        capabilities="$capabilities,\"packages\""
    fi
    [ "$container" -eq 1 ] && capabilities="$capabilities,\"container\""

    os_obj="$(json_obj \
        family '"Linux"' \
        id "$(json_str_max "$(os_release_value ID)" 50)" \
        version_id "$(json_str_max "$(os_release_value VERSION_ID)" 50)" \
        pretty_name "$(json_str_max "$(os_release_value PRETTY_NAME)" 150)" \
        kernel "$kernel" \
        machine "$(json_str_max "$(uname -m 2>/dev/null || true)" 30)" \
        uptime_s "$uptime" \
        patch "$patch_json")"

    instance_obj="$(json_obj \
        hostname "$(json_str_max "${hostname_override:-$(hostname_value)}" 255)" \
        environment "$(json_str_max "$environment" 20)")"
    app_obj="$(json_obj name "$(json_str_max "$app_name" 150)" version "$(json_str_max "$app_version" 64)")"
    [ "$app_obj" = "{}" ] && app_obj=""
    runtime_obj=""
    [ -n "$python_runtime_json" ] && runtime_obj="$(json_obj python "$python_runtime_json")"

    packages_json="$(json_obj composer "$composer_json" pypi "$pypi_json")"
    [ "$packages_json" = "{}" ] && packages_json=""

    reporter_obj="$(json_obj \
        name '"tum/system-report.sh"' \
        version "$(json_str "$VERSION")" \
        context '"cli"' \
        capabilities "[$capabilities]")"

    for e in "${errors[@]+"${errors[@]}"}"; do
        [ -z "$e" ] && continue
        errors_json="${errors_json:+$errors_json,}$(json_str_max "$e" 500)"
    done

    json_obj \
        schema "$(json_str "$SCHEMA")" \
        reported_at "$(json_str "$reported_at")" \
        reporter "$reporter_obj" \
        instance "$instance_obj" \
        app "$app_obj" \
        runtime "$runtime_obj" \
        os "$os_obj" \
        packages "$packages_json" \
        collect_errors "${errors_json:+[$errors_json]}"
    echo
}

# --- Konfiguration -------------------------------------------------------

# Liest KEY=VALUE, ohne die Datei auszuführen (kein "source").
config_value() {
    local line
    [ -r "$config_file" ] || return 0
    line="$(grep -E "^[[:space:]]*$1[[:space:]]*=" "$config_file" | tail -n1 || true)"
    line="${line#*=}"
    line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/")"
    printf '%s' "$line"
}

is_safe_url() {
    case "$1" in
        https://*) return 0 ;;
        http://localhost[:/]*|http://localhost|http://127.0.0.1[:/]*|http://127.0.0.1|http://\[::1\]*) return 0 ;;
        *) return 1 ;;
    esac
}

# --- Ablauf --------------------------------------------------------------

if [ -n "$send_payload" ]; then
    if [ "$send_payload" = "-" ]; then
        payload="$(cat)"
    elif [ -r "$send_payload" ]; then
        payload="$(cat "$send_payload")"
    else
        echo "Payload-Datei nicht lesbar: $send_payload" >&2
        exit 2
    fi
    case "$payload" in
        '{'*'}') ;;
        *) echo "Payload ist kein JSON-Objekt." >&2; exit 2 ;;
    esac
else
    # Eine Subshell für alles: patch_value und die Fehlerliste teilen sie sich.
    payload="$(build_payload)"
fi

if [ "$dry_run" -eq 1 ]; then
    printf '%s\n' "$payload"
    exit 0
fi

token="${TUM_SYSTEM_REPORT_TOKEN:-$(config_value TOKEN)}"
url="${TUM_SYSTEM_REPORT_URL:-$(config_value URL)}"
url="${url:-$DEFAULT_URL}"

if [ -z "$token" ]; then
    echo "Kein Token: TOKEN=itps_… in $config_file eintragen (Rechte 600)." >&2
    exit 2
fi
case "$token" in
    itps_*) ;;
    *) echo "Token hat nicht das Format itps_…" >&2; exit 2 ;;
esac
if ! is_safe_url "$url"; then
    echo "URL muss https sein (http nur für localhost) — sonst ginge das Token im Klartext übers Netz." >&2
    exit 2
fi
if ! command -v curl >/dev/null 2>&1; then
    echo "curl fehlt." >&2
    exit 2
fi

if [ "$random_delay" -gt 0 ] 2>/dev/null; then
    sleep $((RANDOM % random_delay))
fi

body_file="$(mktemp)"
response_file="$(mktemp)"
trap 'rm -f "$body_file" "$response_file"' EXIT
printf '%s' "$payload" > "$body_file"

# Token über stdin als Header, nicht als Argument (sonst in `ps` sichtbar).
# Kein -L: ein Redirect machte aus dem POST ein GET ohne Body.
set +e
status="$(printf 'Authorization: Bearer %s\n' "$token" | curl -sS \
    --max-time 30 --retry 3 --retry-delay 2 \
    -H @- \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json' \
    -H "User-Agent: tum-system-report/$VERSION" \
    --data-binary @"$body_file" \
    -o "$response_file" -w '%{http_code}' \
    "$url")"
curl_exit=$?
set -e

if [ "$curl_exit" -ne 0 ]; then
    echo "Portal nicht erreichbar (curl exit $curl_exit)." >&2
    exit 1
fi

response="$(head -c 500 "$response_file" | tr -d '\000-\037')"
case "$status" in
    2??)
        case "$response" in
            *'"status":"accepted"'*) ;;
            *) echo "Unerwartete Antwort (HTTP $status): $response" >&2; exit 1 ;;
        esac
        ;;
    *)
        echo "HTTP $status: $response" >&2
        exit 1
        ;;
esac

case "$response" in
    *'"stored":true'*) echo "Gemeldet (neuer Stand gespeichert)." ;;
    *) echo "Gemeldet (Stand unverändert)." ;;
esac
